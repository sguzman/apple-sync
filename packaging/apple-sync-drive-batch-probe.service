[Unit]
Description=Manually requested, read-only metered iCloud Drive two-folder batch probe
Documentation=https://github.com/sguzman/apple-sync
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/usr/local/libexec/apple-sync-drive-metered
ExecStart=/usr/bin/python3 /usr/local/libexec/apple-sync-drive-metered/metered_drive_batch_probe.py --execute
TimeoutStartSec=15min
UMask=0077
Nice=10
StandardOutput=journal
StandardError=journal

# Static manual-only comparison; no timer, no enablement, no archive writes.
